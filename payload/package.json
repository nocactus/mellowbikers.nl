{
  "name": "mellowbikers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:database": "node scripts/require-remote.mjs && cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc --noEmit",
    "migrate:content": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/migrate-content.ts",
    "test:dates": "tsx scripts/lib/parseDutchDate.test.mjs",
    "build:worker": "npm run build && opennextjs-cloudflare build",
    "migrate:content:remote": "node scripts/require-remote.mjs && npm run migrate:content",
    "postinstall": "node scripts/patch-payload-pbkdf2.mjs"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.14.0",
    "@opennextjs/cloudflare": "^1.11.0",
    "@payloadcms/db-d1-sqlite": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-form-builder": "3.90.1",
    "@payloadcms/plugin-redirects": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-r2": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "cross-env": "^10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.90.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
